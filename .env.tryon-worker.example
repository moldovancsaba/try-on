#
# Copy to `.env.tryon-worker` on the try-on machine and fill the real values.
# This file is the worker-specific contract for Camera → Try-On integration.
# The local worker is designed to run continuously and process one job at a time.
#

MONGODB_ATLAS_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=MyCluster
MONGODB_DB_NAME=camera

IMGBB_API_KEY=

CAMERA_TRYON_COMPLETE_URL=
CAMERA_TRYON_INTERNAL_SECRET=

TRYON_QUEUE_ROOT=
TRYON_SUIT_ASSET_ROOT=
TRYON_LOCAL_API_URL=
TRYON_LOCAL_API_TIMEOUT_SECONDS=900
SEGMIND_API_URL=
SEGMIND_API_TIMEOUT_SECONDS=180
SEGMIND_API_KEY=
# Optional external provider tier. Leave blank to use local fallback only.
FAL_KEY=
# Optional external provider endpoint/model. Leave blank unless configured privately.
FAL_BASE_URL=
FAL_TRYON_MODEL=
FAL_TRYON_TIMEOUT_SECONDS=300
TRYON_ALLOWED_PERSON_SOURCE_HOSTS=i.ibb.co
TRYON_ALLOWED_SUIT_SOURCE_HOSTS=i.ibb.co
TRYON_MAX_SOURCE_IMAGE_BYTES=26214400
TRYON_MAX_SUIT_IMAGE_BYTES=26214400
TRYON_ALLOW_REDIRECTS=false
TRYON_SETUP_COLLECTION=tryon_setups
TRYON_CAMERA_SETUP_PREFERENCE_COLLECTION=camera_setup_preferences
TRYON_SETUP_CATALOG_PATH=.config/tryon_setups.json
TRYON_DEFAULT_SETUP_ID=

TRYON_WORKER_ID=
# Not read by the worker. Poll interval lives in the worker settings store and is
# changed via /api/worker/settings or the Worker Control page; 60s is the default.
TRYON_POLL_INTERVAL_SECONDS=60
TRYON_LEASE_DURATION_SECONDS=600
TRYON_MAX_ATTEMPTS=3

# Critical infrastructure controls. Keep production defaults conservative.
TRYON_MAX_CONCURRENCY=1
TRYON_BACKPRESSURE_ENABLED=true
TRYON_BACKPRESSURE_MAX_READY_JOBS=50
TRYON_BACKPRESSURE_MAX_OLDEST_READY_AGE_SECONDS=3600
TRYON_PROVIDER_FAILURE_THRESHOLD=3
TRYON_PROVIDER_COOLDOWN_SECONDS=900
TRYON_LOCAL_DAILY_LIMIT=10000
SEGMIND_DAILY_LIMIT=500
FAL_DAILY_LIMIT=500
IMGBB_DAILY_LIMIT=2000
CAMERA_CALLBACK_DAILY_LIMIT=5000
