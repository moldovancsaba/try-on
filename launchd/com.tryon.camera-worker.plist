<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tryon.camera-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/Projects/try-on/.venv311/bin/tryon-queue-worker</string>
        <string>/Users/Shared/Projects/try-on/scripts/tryon_queue_worker.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>LC_ALL</key>
        <string>en_US.UTF-8</string>
        <key>TRYON_MODELS_ROOT</key>
        <string>/Users/Shared/Models</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/Projects/try-on</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/Projects/try-on/queue/logs/worker.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/Projects/try-on/queue/logs/worker.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
